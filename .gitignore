# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.claude

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Excecao: o .env.example so tem placeholders e documenta as variaveis
# necessarias para rodar o projeto. Nunca colocar valor real aqui.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
# Reafirma a excecao: o `.env*` acima foi acrescentado pela CLI da Vercel
# durante `vercel link` e, por vir depois, anulava a regra do topo do arquivo.
!.env.example

# Extratos e faturas de verdade. Documento bancario nao entra em repositorio:
# a fatura traz numero de cartao, CPF e o historico de compras. Para testar o
# importador, use os exemplos anonimos de docs/ ou um arquivo fora do projeto.
*.ofx
*.OFX
Fatura*.pdf
Fatura*.PDF
extrato*.pdf
extrato*.PDF
NU_*.pdf

# Scripts descartaveis de uma sessao de trabalho.
_*.js
_*.ts
_*.mjs
