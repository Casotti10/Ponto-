generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Unica variavel exigida pelo schema. Em runtime ela e a conexao COM pool
  // (PgBouncer, no Neon), que e o que se quer num ambiente serverless.
  //
  // As migrations precisam de conexao SEM pool — operacoes de schema dependem
  // de sessao e de prepared statements que o pooler nao preserva. Em vez de
  // declarar `directUrl` aqui, o buildCommand do vercel.json sobrescreve
  // DATABASE_URL so na chamada do `prisma migrate deploy`.
  //
  // O motivo e concreto: `directUrl = env("X")` faz o Prisma abortar com P1012
  // se X nao existir, mesmo quando nao ha migration a aplicar. Resolver a
  // conexao direta no shell mantem o schema com uma dependencia so.
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EntryType {
  ENTRADA
  SAIDA_ALMOCO
  RETORNO_ALMOCO
  SAIDA
}

enum EntrySource {
  MANUAL
  PONTO_RAPIDO
  IMPORTACAO
  AJUSTE
}

enum AbsenceType {
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
  BANCO_HORAS
  FOLGA
  FERIAS
  LICENCA
  COMPENSACAO
  HOME_OFFICE
}

enum AbsenceImpact {
  NEUTRO // não afeta o saldo (ex: férias, licença) - não gera déficit
  DESCONTA // desconta a jornada prevista do saldo (falta injustificada)
  ABATE_BANCO // consome horas do banco de horas (banco de horas / compensação)
  NAO_DESCONTA // falta justificada: não desconta e não soma
}

enum AdjustmentType {
  MANUAL_ADD
  MANUAL_REMOVE
  FECHAMENTO_MENSAL
  CORRECAO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ADJUST
  CLOSE_MONTH
}

enum AuditEntity {
  TIME_ENTRY
  ABSENCE
  BALANCE_ADJUSTMENT
  WORK_SCHEDULE
  USER
  GOAL
  TRANSACTION
  ACCOUNT
  CATEGORY
  RECURRING_TRANSACTION
  TASK_BOARD
  TASK_COLUMN
  TASK_CARD
}

// ---------------------------------------------------------------------------
// Módulo financeiro: razão de entradas e saídas.
// Independente do controle de ponto — nenhum modelo abaixo lê ou altera horas.
// ---------------------------------------------------------------------------

enum TransactionType {
  ENTRADA // dinheiro que entra
  SAIDA // dinheiro que sai
}

enum AccountType {
  CORRENTE
  POUPANCA
  CARTEIRA // dinheiro em espécie
  CARTAO // cartão de crédito
  INVESTIMENTO
}

enum RecurrenceFrequency {
  MENSAL
  SEMANAL
  ANUAL
}

// ---------------------------------------------------------------------------
// Módulo de tarefas: quadro Kanban.
// Independente do ponto e do financeiro — nenhum modelo abaixo lê horas ou dinheiro.
// ---------------------------------------------------------------------------

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/// Tipos de evento da linha do tempo do card. É um enum e não texto livre para
/// que o ícone e o agrupamento do histórico sejam decididos no código, e não
/// por comparação de string.
enum TaskActivityType {
  CARD_CREATED
  CARD_MOVED
  CARD_RENAMED
  CARD_UPDATED
  CARD_DUPLICATED
  CARD_COMPLETED
  CARD_REOPENED
  CARD_DELETED
  CHECKLIST_UPDATED
  NOTES_UPDATED
  LABELS_UPDATED
  COLUMN_CREATED
  COLUMN_RENAMED
  COLUMN_DELETED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timeEntries         TimeEntry[]
  absences            Absence[]
  balanceAdjustments  BalanceAdjustment[]
  workSchedule        WorkSchedule?
  auditLogs           AuditLog[]
  goals               Goal[]
  monthlyClosures     MonthlyClosure[]
  notifications       Notification[]
  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  recurringTransactions RecurringTransaction[]
  boards              Board[]
  assignedCards       TaskCard[]
  taskActivities      TaskActivity[]

  @@index([email])
}

model WorkSchedule {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String   @unique
  dailyHours           Float    @default(8) // jornada diária em horas
  weeklyHours          Float    @default(40) // carga semanal
  lunchBreakMinutes    Int      @default(60) // intervalo obrigatório em minutos
  toleranceMinutes     Int      @default(10) // tolerância de atraso
  workDays             Int[]    @default([1, 2, 3, 4, 5]) // 0=domingo ... 6=sábado
  entryTime            String   @default("08:00") // horário previsto de entrada HH:mm
  lunchOutTime         String   @default("12:00")
  lunchReturnTime      String   @default("13:00")
  exitTime             String   @default("17:00")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model TimeEntry {
  id          String      @id @default(cuid())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  date        DateTime    // dia do registro à meia-noite local (sem @db.Date: ver nota de timezone)
  type        EntryType
  time        DateTime // data+hora completa do evento
  notes       String?
  source      EntrySource @default(MANUAL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, date])
  @@index([userId, type, date])
}

model Absence {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  date        DateTime
  endDate     DateTime?     // para intervalos (férias/licença)
  type        AbsenceType
  impact      AbsenceImpact
  hours       Float? // horas específicas abatidas/creditadas quando aplicável
  reason      String?
  approved    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, date])
  @@index([userId, type])
}

model BalanceAdjustment {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime       @default(now())
  minutes   Int // positivo = crédito, negativo = débito
  type      AdjustmentType
  reason    String
  createdAt DateTime       @default(now())

  @@index([userId, date])
}

model MonthlyClosure {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  year          Int
  month         Int // 1-12
  balanceMinutes Int // saldo acumulado ao final do mês (em minutos)
  workedMinutes Int
  expectedMinutes Int
  extraMinutes  Int
  negativeMinutes Int
  closedAt      DateTime @default(now())

  @@unique([userId, year, month])
}

model Goal {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  title      String
  targetHours Float
  year       Int
  month      Int
  createdAt  DateTime @default(now())

  @@index([userId, year, month])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// Conta ou carteira onde o dinheiro fica (Nubank, Itaú, espécie, cartão...).
/// O saldo NÃO é armazenado: é sempre `openingBalanceCents` + soma dos
/// lançamentos. Guardar saldo denormalizado abriria espaço para divergência
/// entre o total e o extrato — e o extrato é a verdade.
model Account {
  id                  String      @id @default(cuid())
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  name                String
  type                AccountType @default(CORRENTE)
  /// Saldo que a conta já tinha antes do primeiro lançamento registrado aqui.
  openingBalanceCents Int         @default(0)
  color               String      @default("#2a78d6")
  archived            Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name])
  @@index([userId, archived])
}

/// Categoria de um lançamento. Pertence a UM tipo (entrada ou saída) para que
/// o formulário só ofereça categorias compatíveis com o que está sendo lançado.
model Category {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  type      TransactionType
  color     String          @default("#898781")
  archived  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

/// Um lançamento do razão.
///
/// `amountCents` é SEMPRE positivo — o sinal vem de `type`. Guardar em centavos
/// (Int) evita erro de ponto flutuante em dinheiro e segue o padrão que o resto
/// do sistema já usa para minutos.
model Transaction {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  date        DateTime // dia do lançamento à meia-noite local
  description String
  amountCents Int
  type        TransactionType
  notes       String?

  /// Preenchido quando o lançamento nasceu de uma recorrência.
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  recurringId String?

  /// Identidade do lançamento na ORIGEM, quando ele veio de um extrato
  /// importado: o FITID do OFX ou, para CSV (que não tem id), uma impressão
  /// digital determinística do próprio lançamento. É o que torna a importação
  /// idempotente — reimportar o mesmo extrato não duplica nada.
  /// Nulo em lançamento digitado à mão; no Postgres nulos não colidem entre si,
  /// então a restrição única abaixo não atrapalha o cadastro manual.
  externalId String?
  importedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Garante que a materialização das recorrências seja idempotente: a mesma
  /// recorrência não pode gerar dois lançamentos para a mesma data.
  @@unique([recurringId, date])
  /// Trava de idempotência da importação de extratos: o mesmo lançamento do
  /// mesmo banco não entra duas vezes, nem em reimportação nem em extratos com
  /// período sobreposto.
  @@unique([accountId, externalId])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([accountId, date])
  @@index([categoryId])
  @@index([userId, importedAt])
}

/// Modelo de lançamento que se repete (aluguel, salário, assinatura).
/// Não é um lançamento: é a receita para gerar lançamentos reais mês a mês.
model RecurringTransaction {
  id          String              @id @default(cuid())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  account     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  description String
  amountCents Int
  type        TransactionType
  frequency   RecurrenceFrequency @default(MENSAL)

  /// MENSAL e ANUAL: dia do mês (1-31, ajustado para o último dia em meses curtos).
  dayOfMonth Int @default(1)
  /// SEMANAL: 0=domingo ... 6=sábado.
  weekday    Int @default(1)
  /// ANUAL: mês de referência (1-12).
  monthOfYear Int @default(1)

  startDate DateTime
  endDate   DateTime?
  active    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId, active])
}

/// Um quadro Kanban. O usuário pode ter vários (trabalho, pessoal, um por
/// projeto) e alterna entre eles pela barra superior da página.
model Board {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  columns    BoardColumn[]
  cards      TaskCard[]
  labels     TaskLabel[]
  activities TaskActivity[]

  @@unique([userId, name])
  @@index([userId, position])
}

/// Coluna (lista) do quadro. A ordem visual vive em `position`, reescrita em
/// bloco a cada movimento — ver `reorderPositions` em `src/lib/task-calc.ts`.
model BoardColumn {
  id        String   @id @default(cuid())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  name      String
  color     String   @default("#898781")
  position  Int
  /// Coluna terminal: card que chega aqui é marcado como concluído, e card que
  /// sai deixa de ser. É o que faz "arrastar para Concluído" ter significado.
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards TaskCard[]

  @@index([boardId, position])
}

/// Um card (tarefa).
///
/// `boardId` é redundante com `column.boardId`, e é proposital: a consulta do
/// quadro e todas as checagens de posse filtram por board sem precisar de join
/// com a coluna, e o card sobrevive a uma troca de coluna sem perder o vínculo.
model TaskCard {
  id          String       @id @default(cuid())
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String
  column      BoardColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId    String
  title       String
  description String?
  /// Cor de destaque do card. Nulo = card neutro, com a cor padrão da superfície.
  color       String?
  priority    TaskPriority @default(MEDIA)
  dueDate     DateTime?
  position    Int
  completed   Boolean      @default(false)
  completedAt DateTime?
  /// Responsável pela tarefa. Hoje sempre o próprio dono do quadro; o campo
  /// existe para que atribuir a outra pessoa não exija migração de dados.
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  checklists Checklist[]
  labels     TaskCardLabel[]
  note       TaskNote?
  activities TaskActivity[]

  @@index([boardId, columnId, position])
  @@index([boardId, dueDate])
  @@index([assigneeId])
}

/// Etiqueta reutilizável dentro de um quadro.
model TaskLabel {
  id        String   @id @default(cuid())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  name      String
  color     String   @default("#2a78d6")
  createdAt DateTime @default(now())

  cards TaskCardLabel[]

  @@unique([boardId, name])
  @@index([boardId])
}

/// Junção card↔etiqueta. Explícita (e não N-N implícita do Prisma) para que a
/// tabela tenha nome estável e possa receber colunas próprias depois.
model TaskCardLabel {
  card    TaskCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId  String
  label   TaskLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId String

  @@id([cardId, labelId])
  @@index([labelId])
}

model Checklist {
  id        String   @id @default(cuid())
  card      TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  title     String   @default("Checklist")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ChecklistItem[]

  @@index([cardId, position])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String
  content     String
  done        Boolean   @default(false)
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([checklistId, position])
}

/// Anotações do card, em tabela própria e não como coluna de `TaskCard`.
///
/// O motivo é a consulta do quadro: ela carrega todos os cards de todas as
/// colunas, e o corpo da anotação pode ter milhares de caracteres. Separado,
/// esse texto só é lido quando o card é aberto.
model TaskNote {
  id        String   @id @default(cuid())
  card      TaskCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Linha do tempo do quadro. `cardId` é SetNull de propósito: quando o card é
/// excluído o evento "excluiu o card X" precisa continuar existindo, e o título
/// necessário para exibi-lo já está em `message`.
model TaskActivity {
  id        String           @id @default(cuid())
  board     Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  card      TaskCard?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cardId    String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      TaskActivityType
  /// Frase pronta em pt-BR ("moveu o card para Em andamento"). Guardada renderizada
  /// para que o histórico não mude de sentido se a coluna for renomeada depois.
  message   String
  createdAt DateTime         @default(now())

  @@index([boardId, createdAt])
  @@index([cardId, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  entity     AuditEntity
  entityId   String
  action     AuditAction
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
