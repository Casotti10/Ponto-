# Conexao usada pela aplicacao. No Neon, e a string COM pool (host com "-pooler").
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Conexao direta, SEM pool, usada so pelo Prisma CLI nas migrations.
# No Neon/Vercel a integracao ja cria essa variavel automaticamente.
# Em Postgres local, sem pooler, repita o mesmo valor de DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_NAME="Ponto+"
