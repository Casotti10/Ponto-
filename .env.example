# Conexao usada pela aplicacao. No Neon, e a string COM pool (host com "-pooler").
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# OPCIONAL. Conexao direta, SEM pool, usada so pelas migrations no deploy.
# No Neon/Vercel a integracao ja cria essa variavel automaticamente; se ela
# nao existir, o build cai para POSTGRES_URL_NON_POOLING e depois para a
# propria DATABASE_URL. Em Postgres local, sem pooler, pode omitir.
DATABASE_URL_UNPOOLED=""
JWT_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_NAME="Ponto+"
# OPCIONAL. Fuso usado para resolver "agora" e "hoje" no registro de ponto.
# O servidor roda em UTC na Vercel, entao sem isso o ponto rapido gravaria o
# relogio do servidor e nao o do usuario. Padrao: America/Sao_Paulo.
NEXT_PUBLIC_APP_TIMEZONE="America/Sao_Paulo"
